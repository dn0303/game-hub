rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function myApproval() { return /databases/$(database)/documents/approved/$(myEmail()); }
    function isApproved() { return signedIn() && exists(myApproval()); }
    function isAdmin() { return isApproved() && get(myApproval()).data.admin == true; }

    // approved/{email}: who may add games. admin:true also lets them approve others.
    match /approved/{em} {
      allow get: if signedIn() && (em == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && em == em.lower()
        && request.resource.data.keys().hasOnly(['admin', 'addedBy'])
        && request.resource.data.admin is bool;
      allow delete: if isAdmin() && em != myEmail();
    }

    // Reflex Range leaderboard: lb/{drill}_{length}/scores/{player id}, one best score per player per board.
    function validScore(board, pid) {
      let d = request.resource.data;
      return board.matches('^(grid|snap|micro|reflex|peek|drift|track|tac)_(30|60|90)$')
        && pid.matches('^[a-z0-9]{20}$')
        && d.keys().hasOnly(['name', 'score', 'acc', 'at', 'st'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.score is int && d.score >= 0 && d.score <= 200000
        && d.acc is number && d.acc >= 0 && d.acc <= 1
        && d.at == request.time
        && (!('st' in d) || (d.st is map && d.st.size() <= 8));
    }
    match /lb/{board}/scores/{pid} {
      allow read: if true;
      allow create: if validScore(board, pid);
      allow update: if validScore(board, pid) && request.resource.data.score >= resource.data.score;
      allow delete: if isAdmin();
    }

    match /games/{id} {
      allow read: if true;
      allow create: if isApproved()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 140
        && request.resource.data.chunks is int && request.resource.data.chunks <= 70
        && request.resource.data.complete == false;
      allow update: if isApproved() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete']);
      allow delete: if isAdmin() || (isApproved() && resource.data.owner == request.auth.uid);

      match /parts/{n} {
        allow read: if true;
        allow create, update: if isApproved()
          && get(/databases/$(database)/documents/games/$(id)).data.owner == request.auth.uid;
        allow delete: if isAdmin() || (isApproved()
          && get(/databases/$(database)/documents/games/$(id)).data.owner == request.auth.uid);
      }
    }
  }
}
