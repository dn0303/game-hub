rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function myApproval() { return /databases/$(database)/documents/approved/$(myEmail()); }
    function isApproved() { return signedIn() && exists(myApproval()); }
    function isAdmin() { return isApproved() && get(myApproval()).data.admin == true; }

    // approved/{email}: who may add games. admin:true also lets them approve others.
    match /approved/{em} {
      allow get: if signedIn() && (em == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && em == em.lower()
        && request.resource.data.keys().hasOnly(['admin', 'addedBy'])
        && request.resource.data.admin is bool;
      allow delete: if isAdmin() && em != myEmail();
    }

    match /games/{id} {
      allow read: if true;
      allow create: if isApproved()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 140
        && request.resource.data.chunks is int && request.resource.data.chunks <= 70
        && request.resource.data.complete == false;
      allow update: if isApproved() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete']);
      allow delete: if isAdmin() || (isApproved() && resource.data.owner == request.auth.uid);

      match /parts/{n} {
        allow read: if true;
        allow create, update: if isApproved()
          && get(/databases/$(database)/documents/games/$(id)).data.owner == request.auth.uid;
        allow delete: if isAdmin() || (isApproved()
          && get(/databases/$(database)/documents/games/$(id)).data.owner == request.auth.uid);
      }
    }
      // ---------- Frosty Peaks: one cloud save per Google account
    match /fp_saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && fpSaveOk()
        && request.resource.data.points <= 3000000 && request.resource.data.earned <= 3000000;
      allow update: if request.auth != null && request.auth.uid == uid && fpSaveOk()
        && request.time > resource.data.at + duration.value(5, 's')
        && request.resource.data.earned >= resource.data.earned
        && request.resource.data.earned - resource.data.earned <= 3000000
        && request.resource.data.points - resource.data.points <= 3000000;
    }
    function fpSaveOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['s', 'points', 'earned', 'name', 'at'])
        && d.s is string && d.s.size() < 100000
        && d.points is int && d.points >= 0 && d.points <= 100000000
        && d.earned is int && d.earned >= 0
        && d.name is string && d.name.size() <= 16
        && d.at == request.time;
    }

    // ---------- Frosty Peaks: all-time Jingle Race board (one best time per account)
    match /fp_lb/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && fpLbOk();
      allow update: if request.auth != null && request.auth.uid == uid && fpLbOk()
        && (request.resource.data.t < resource.data.t
            || resource.data.at < timestamp.value(1794166200000));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    function fpLbOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 't', 'at'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.t is number && d.t >= 12 && d.t <= 400
        && d.at == request.time;
    }
      // ---------- Frosty Peaks: Gingerbread Hall (one showcased cookie per account) + likes
    match /fp_cookies/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && fpCookieOk()
        && request.resource.data.likes == 0;
      allow update: if request.auth != null && (
        (request.auth.uid == uid && fpCookieOk() && request.resource.data.likes == 0
          && request.resource.data.v > resource.data.v)
        || (request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && request.resource.data.likes == resource.data.likes + 1
          && !exists(/databases/$(database)/documents/fp_cookie_likes/$(uid + '_' + string(resource.data.v) + '_' + request.auth.uid))
          && existsAfter(/databases/$(database)/documents/fp_cookie_likes/$(uid + '_' + string(resource.data.v) + '_' + request.auth.uid))));
      // your own cookie, or the game owner taking down something inappropriate
      allow delete: if request.auth != null && (request.auth.uid == uid
        || (request.auth.token.email == 'daenii066@gmail.com' && request.auth.token.email_verified == true));
    }
    function fpCookieOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'img', 'v', 'likes', 'at'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.img is string && d.img.size() < 200000
        && d.v is int && d.v >= 1 && d.likes is int
        && d.at == request.time;
    }
    match /fp_cookie_likes/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['c', 'v', 'by'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.c != request.auth.uid
        && id == request.resource.data.c + '_' + string(request.resource.data.v) + '_' + request.auth.uid
        && getAfter(/databases/$(database)/documents/fp_cookies/$(request.resource.data.c)).data.likes
           == get(/databases/$(database)/documents/fp_cookies/$(request.resource.data.c)).data.likes + 1;
    }
  }
}
